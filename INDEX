<!DOCTYPE html><html lang="id"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><title>Kasir Dimpik</title>
<style>
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}body{margin:0;font-family:system-ui,sans-serif;background:#FFFDF0;color:#212121}button{font:inherit;cursor:pointer}
header{position:sticky;top:0;z-index:5;background:#FFD600;padding:10px 14px;display:flex;align-items:center;gap:8px;font-weight:800}header span{flex:1}header button{border:0;background:#fff;border-radius:8px;padding:6px 10px}
#st{font-size:11px;background:#fff;border-radius:99px;padding:3px 8px;font-weight:600}
.nav{display:flex;background:#fff}.nav button{flex:1;padding:12px;border:0;background:none;font-weight:700;border-bottom:3px solid transparent}.nav .on{border-color:#FF6F00;color:#E65100}
#cats{display:flex;gap:8px;overflow-x:auto;padding:10px 12px}.c{border:1px solid #ddd;background:#fff;border-radius:99px;padding:9px 15px;white-space:nowrap;font-weight:700}.c.on{background:#FF6F00;color:#fff;border-color:#FF6F00}
.m{display:flex;align-items:center;gap:8px;background:#fff;margin:0 12px 8px;padding:12px;border-radius:14px;border:1px solid #FFE082}.m>div:first-child{flex:1}.m b{display:block;font-size:15px}.m i{font-style:normal;color:#E65100;font-weight:800}
.q{display:flex;align-items:center;gap:10px}.q button{width:44px;height:44px;border-radius:12px;border:0;background:#FFD600;font-size:22px;font-weight:800}.q b{min-width:18px;text-align:center}
#bar{position:fixed;bottom:0;left:0;right:0;background:#fff;border-top:2px solid #FFD600;padding:10px 12px calc(10px + env(safe-area-inset-bottom));z-index:6}
.seg{display:flex;gap:8px;margin-bottom:8px}.seg button{flex:1;padding:11px;border-radius:12px;border:2px solid #FFD600;background:#fff;font-weight:700}.seg .on{background:#FFD600}
#pay{width:100%;padding:15px;border:0;border-radius:14px;background:#FF6F00;color:#fff;font-size:18px;font-weight:800}#pay:disabled{background:#ccc}
#v1{padding-bottom:150px}.box{max-width:340px;margin:12vh auto;padding:20px}.box input{width:100%;padding:14px;margin:6px 0;border:1px solid #ddd;border-radius:12px;font:inherit}.box button{width:100%;padding:14px;border:0;border-radius:12px;background:#FF6F00;color:#fff;font-weight:800;margin-top:6px}
.h{background:#fff;margin:0 12px 8px;padding:12px;border-radius:14px;border:1px solid #eee}.h small{color:#666;display:block;margin-top:4px}.h .t{float:right;color:#E65100}
#pop,#pm,#qr{display:none;position:fixed;inset:0;background:#000a;z-index:20;align-items:center;justify-content:center;padding:20px}#pop>div,#pm>div,#qr>div{background:#fff;border-radius:20px;padding:22px;width:100%;max-width:340px;text-align:center}#pop .tot,#pm .tot,#qr .tot{font-size:40px;font-weight:900;color:#E65100;margin:6px 0 10px}#pop .it{text-align:left;font-size:14px;color:#555;max-height:30vh;overflow:auto;border-top:1px dashed #ddd;padding-top:8px}#pop button,#pm button,#qr button{width:100%;margin-top:14px;padding:15px;border:0;border-radius:14px;background:#FF6F00;color:#fff;font-size:18px;font-weight:800}
</style></head><body>
<div id="lg" class="box"><h2>🥟 Kasir Dimpik</h2><input id="u" placeholder="ID kasir" autocapitalize="none" autocomplete="username"><input id="p" type="password" placeholder="Password" autocomplete="current-password"><button onclick="login()">MASUK</button><p id="er" style="color:#c00"></p></div>
<div id="app" style="display:none"><header>🥟 <span id="nm"></span><b id="st"></b><button onclick="out()">Keluar</button></header>
<div class="nav"><button id="n1" class="on" onclick="tab(1)">Kasir</button><button id="n2" onclick="tab(2)">Riwayat</button></div>
<div id="v1"><div id="cats"></div><div id="list"></div></div>
<div id="v2" style="display:none"><div style="padding:12px;display:flex;gap:8px"><input type="date" id="dt" onchange="hist()" style="flex:1;padding:10px;border-radius:10px;border:1px solid #ddd;font:inherit"><button onclick="hist()" style="padding:10px 16px;border-radius:10px;border:0;background:#FFD600;font-weight:700">⟳</button></div><div id="sum" style="padding:0 14px 8px;font-weight:800"></div><div id="hl"></div></div>
<div id="bar"><div class="seg"><button id="t1" class="on" onclick="tp('Takeaway')">Takeaway</button><button id="t2" onclick="tp('Delivery')">Delivery</button></div><button id="pay" onclick="pay()" disabled>SIMPAN</button></div></div>
<div id="pop"><div><div>✅ Pesanan disimpan · <b id="pt"></b></div><div class="tot" id="pv"></div><div class="it" id="pi"></div><button onclick="toPay()">LANJUT PEMBAYARAN ▶</button><button onclick="$('pop').style.display='none'" style="background:#eee;color:#333;font-size:15px">← Ubah pesanan</button></div></div>
<div id="pm"><div><div>Pilih pembayaran · <b id="pm1"></b></div><div class="tot" id="pm2"></div><button onclick="done('Cash')" style="background:#2e7d32">💵 CASH</button><button onclick="done('QR')" style="background:#1565c0">📱 QR</button><button onclick="$('pm').style.display='none';$('pop').style.display='flex'" style="background:#eee;color:#333;font-size:15px">← Kembali</button></div></div>
<div id="qr"><div><div>Scan QRIS · <b id="q1"></b></div><div class="tot" id="q2"></div><div id="qc" style="display:flex;justify-content:center"></div><img id="qi" alt="QRIS" style="width:100%;max-width:300px;display:none" src="data:image/png;base64,"><div id="qn" style="font-size:12px;color:#777;margin-top:8px"></div><button onclick="$('qr').style.display='none'">SELESAI</button></div></div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<script>
const M=[["pr-1", "Promo Dimsum Goreng Keju Lumer (Isi 3)", "promo", 16000], ["pr-2", "Promo Goreng Keju Lumer + Mentai (Isi 4) + Gratis Chili Oil", "promo", 34000], ["i4-1", "Dimsum Original (Isi 4)", "isi4", 14000], ["i4-2", "Dimsum Goreng (Isi 4)", "isi4", 16000], ["i4-3", "Dimsum Mentai (Isi 4)", "isi4", 18000], ["i4-4", "Dimsum Ha Hu (Isi 4)", "isi4", 18000], ["i4-5", "Dimsum Nori Goreng (Isi 4)", "isi4", 16000], ["i4-6", "Dimsum Mentai Keju (Isi 4)", "isi4", 21000], ["i6-1", "Dimsum Original (Isi 6)", "isi6", 21000], ["i6-2", "Dimsum Goreng (Isi 6)", "isi6", 24000], ["i6-3", "Dimsum Mentai (Isi 6)", "isi6", 27000], ["i6-4", "Dimsum Ha Hu (Isi 6)", "isi6", 27000], ["i6-5", "Dimsum Nori Goreng (Isi 6)", "isi6", 24000], ["i6-6", "Dimsum Mentai Keju (Isi 6)", "isi6", 31000], ["i8-1", "Dimsum Original (Isi 8)", "isi8", 28000], ["i8-2", "Dimsum Goreng (Isi 8)", "isi8", 32000], ["i8-3", "Dimsum Mentai (Isi 8)", "isi8", 36000], ["i8-4", "Dimsum Ha Hu (Isi 8)", "isi8", 36000], ["i8-5", "Dimsum Nori Goreng (Isi 8)", "isi8", 32000], ["i8-6", "Dimsum Mentai Keju (Isi 8)", "isi8", 41000], ["i16-1", "Dimsum Original (Isi 16)", "isi16", 56000], ["i16-2", "Dimsum Goreng (Isi 16)", "isi16", 64000], ["i16-3", "Dimsum Mentai (Isi 16)", "isi16", 72000], ["i16-4", "Dimsum Ha Hu (Isi 16)", "isi16", 72000], ["i16-5", "Dimsum Nori Goreng (Isi 16)", "isi16", 64000], ["i16-6", "Dimsum Mentai Keju (Isi 16)", "isi16", 82000], ["sp-1", "Udang Goreng Keju (Isi 3)", "special", 12000], ["sp-2", "Dimsum Goreng Keju Original (Isi 3)", "special", 17000], ["sp-3", "Dimsum Goreng Keju Original (Isi 6)", "special", 33000], ["sp-4", "Dimsum Goreng Keju Mentai (Isi 3)", "special", 23000], ["sp-5", "Dimsum Goreng Keju Mentai (Isi 6)", "special", 45000], ["fz-1", "Dimsum Frozen (Isi 50)", "frozen", 125000], ["ad-1", "Chili Oil Tambahan", "addon", 2000], ["ad-2", "Keju Slice", "addon", 3000], ["ad-3", "Topper Ulang Tahun", "addon", 5000], ["ad-4", "Lilin Ulang Tahun", "addon", 5000]],URL='https://script.google.com/macros/s/AKfycbx7ekeUZfzudONK9i4CUoLfMl5znGeVp7oKKp4wuT736kyeN--95K13VQ_QXrs8b-BC9w/exec',CAT=['Promo','Isi 4','Isi 6','Isi 8','Isi 16','Goreng Keju','Frozen','Add On'],KEY={promo:'Promo',isi4:'Isi 4',isi6:'Isi 6',isi8:'Isi 8',isi16:'Isi 16',special:'Goreng Keju',frozen:'Frozen',addon:'Add On'};
const QRIS='00020101021126650013ID.CO.BCA.WWW011893600014000449090202150008850044909020303UMI51440014ID.CO.QRIS.WWW0215ID10265067435110303UMI5204581453033605802ID5916Dimpik Fast Food6009TANGERANG61051511362070703A016304747D';
function crc16(s){let c=0xFFFF;for(let i=0;i<s.length;i++){c^=s.charCodeAt(i)<<8;for(let j=0;j<8;j++)c=c&0x8000?((c<<1)^0x1021)&0xFFFF:(c<<1)&0xFFFF}return c.toString(16).toUpperCase().padStart(4,'0')}
function qris(n){const a=String(Math.round(n));let s=QRIS.slice(0,-8).replace('010211','010212');const i=s.indexOf('5802ID');s=s.slice(0,i)+'54'+String(a.length).padStart(2,'0')+a+s.slice(i)+'6304';return s+crc16(s)}
const $=id=>document.getElementById(id),rp=n=>'Rp '+Math.round(n).toLocaleString('id-ID'),today=()=>new Date().toLocaleDateString('sv');
let cur=null,S=JSON.parse(localStorage.ses||'null'),cart={},cat='Promo',tipe='Takeaway',Q=JSON.parse(localStorage.antre||'[]'),busy=0;
async function api(o){const r=await fetch(URL,{method:'POST',headers:{'Content-Type':'text/plain;charset=utf-8'},body:JSON.stringify(o)});return r.json()}
async function login(){$('er').textContent='Memeriksa...';try{const u=$('u').value.trim(),p=$('p').value,j=await api({act:'login',u,p});if(!j.ok)throw j;S={u,p,nama:j.nama,peran:j.peran};localStorage.ses=JSON.stringify(S);start()}catch(e){$('er').textContent=e&&e.err=='auth'?'ID atau password salah (atau akun tidak aktif)':e&&e.err?'Script Sheet belum diperbarui: Deploy > New version':'Tidak ada koneksi / URL script salah'}}
function out(){if(Q.length&&!confirm(Q.length+' pesanan belum terkirim. Tetap keluar?'))return;localStorage.removeItem('ses');location.reload()}
function start(){$('lg').style.display='none';$('app').style.display='block';$('nm').textContent=S.nama+(S.peran=='OWNER'?' (Owner)':'');$('dt').value=today();draw();flush()}
function tab(n){$('v1').style.display=n==1?'block':'none';$('v2').style.display=n==2?'block':'none';$('bar').style.display=n==1?'block':'none';$('n1').className=n==1?'on':'';$('n2').className=n==2?'on':'';if(n==2)hist()}
function tp(t){tipe=t;$('t1').className=t=='Takeaway'?'on':'';$('t2').className=t=='Delivery'?'on':''}
function sums(){let s=0;for(const k in cart)s+=M.find(x=>x[0]==k)[3]*cart[k];return s}
function draw(){$('cats').innerHTML=CAT.map(c=>`<button class="c ${c==cat?'on':''}" onclick="cat='${c}';draw()">${c}</button>`).join('');
 $('list').innerHTML=M.filter(m=>KEY[m[2]]==cat).map(m=>{const n=cart[m[0]]||0;return `<div class="m"><div><b>${m[1]}</b><i>${rp(m[3])}</i></div><div class="q">${n?`<button onclick="add('${m[0]}',-1)">−</button><b>${n}</b>`:''}<button onclick="add('${m[0]}',1)">+</button></div></div>`}).join('');
 const c=Object.values(cart).reduce((a,b)=>a+b,0);$('pay').disabled=!c;$('pay').textContent=c?`SIMPAN · ${c} item · ${rp(sums())}`:'SIMPAN'}
function add(k,d){cart[k]=(cart[k]||0)+d;if(cart[k]<=0)delete cart[k];draw()}
function pay(){const id='DM'+new Date().toLocaleString('sv').replace(/\D/g,'').slice(2,12)+Math.floor(Math.random()*90+10);
 const o={id,tipe,total:sums(),u:S.u,p:S.p,items:Object.keys(cart).map(k=>{const m=M.find(x=>x[0]==k);return{name:m[1],cat:KEY[m[2]],price:m[3],qty:cart[k]}})};
 cur=o;$('pt').textContent=tipe;$('pv').textContent=rp(o.total);$('pi').innerHTML=o.items.map(i=>`${i.qty}× ${i.name} — ${rp(i.qty*i.price)}`).join('<br>');$('pop').style.display='flex'}
function toPay(){$('pop').style.display='none';$('pm1').textContent=cur.tipe;$('pm2').textContent=rp(cur.total);$('pm').style.display='flex'}
function done(m){cur.metode=m;Q.push(cur);localStorage.antre=JSON.stringify(Q);$('pm').style.display='none';
 if(m=='QR'){$('q1').textContent=cur.tipe;$('q2').textContent=rp(cur.total);const b=$('qc');b.innerHTML='';
  try{new QRCode(b,{text:qris(cur.total),width:260,height:260,correctLevel:QRCode.CorrectLevel.M});b.style.cssText='display:flex;justify-content:center;background:#fff;padding:12px';$('qi').style.display='none';$('qn').textContent='✅ Nominal otomatis terisi di aplikasi bank pembeli.'}
  catch(e){b.innerHTML='';$('qi').style.display='block';$('qn').textContent='Offline: pembeli mengisi nominal sesuai total.'}
  $('qr').style.display='flex'}
 cur=null;cart={};draw();flush()}
async function flush(){if(busy)return;busy=1;$('st').textContent=Q.length?'⏳ '+Q.length:'';
 while(Q.length){try{const j=await api({...Q[0],act:'save'});if(!j.ok){if(j.err=='auth')$('st').textContent='⛔ Akun tidak valid';throw 0}Q.shift();localStorage.antre=JSON.stringify(Q)}catch(e){break}}
 busy=0;if(!Q.length)$('st').textContent='✅ Tersimpan';else if($('st').textContent[0]!='⛔')$('st').textContent='⏳ '+Q.length+' belum terkirim'}
async function hist(){$('hl').innerHTML='<p style="padding:14px">Memuat...</p>';try{const j=await api({act:'hist',u:S.u,p:S.p,tgl:$('dt').value});if(!j.ok)throw 0;
 $('sum').textContent=j.rows.length+' transaksi · '+rp(j.rows.reduce((a,r)=>a+r.total,0));
 $('hl').innerHTML=j.rows.map(r=>`<div class="h"><b>${r.jam} · ${r.tipe}${r.metode?' · '+(r.metode=='QR'?'📱 ':'💵 ')+r.metode:''}</b><b class="t">${rp(r.total)}</b><small>${r.item}</small><small>${S.peran=='OWNER'?'👤 '+r.kasir+' &nbsp; <a href="#" onclick="del(\''+r.id+'\');return false" style="color:#c00">🗑 Hapus</a>':''}</small></div>`).join('')||'<p style="padding:14px;color:#999">Belum ada transaksi</p>'}catch(e){$('sum').textContent='';$('hl').innerHTML='<p style="padding:14px;color:#c00">Gagal memuat riwayat</p>'}}
async function del(id){if(!confirm('Hapus transaksi ini dari Sheet? Tidak bisa dibatalkan.'))return;try{const j=await api({act:'del',u:S.u,p:S.p,id});if(!j.ok)throw 0;hist()}catch(e){alert('Gagal menghapus')}}
setInterval(flush,15000);if(S)start();
</script></body></html>
