<!DOCTYPE html><html lang="id"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Kasir Dimpik</title>
<style>
*{box-sizing:border-box}body{margin:0;font-family:system-ui,sans-serif;background:#FFFDF0;color:#212121;height:100vh;display:flex;flex-direction:column}
header{background:#FFD600;padding:8px 14px;display:flex;align-items:center;gap:10px;font-weight:800}header span{flex:1}
#st{font-size:12px;background:#fff;border-radius:99px;padding:3px 10px}
main{flex:1;display:flex;min-height:0}.L{flex:1;display:flex;flex-direction:column;padding:10px;min-width:0}.R{width:370px;background:#fff;border-left:2px solid #FFD600;display:flex;flex-direction:column;padding:10px}
#tabs{display:flex;gap:6px;overflow-x:auto;padding-bottom:6px}.tab{border:0;border-radius:12px;padding:8px 12px;font-weight:700;background:#fff;border:1px solid #ddd;white-space:nowrap;cursor:pointer}.tab.on{background:#FF6F00;color:#fff}
#q{padding:9px;border:1px solid #ddd;border-radius:10px;margin:4px 0 8px}
#grid{flex:1;overflow:auto;display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:8px;align-content:start}
.it{background:#fff;border:2px solid #FFE082;border-radius:14px;padding:10px;text-align:left;cursor:pointer;font:inherit}.it:active{background:#FFF59D}.it b{display:block;font-size:13px}.it i{color:#E65100;font-style:normal;font-weight:800}
#cart{flex:1;overflow:auto}.row{display:flex;align-items:center;gap:6px;padding:6px 0;border-bottom:1px dashed #ddd;font-size:13px}.row span{flex:1}
.row button{width:26px;height:26px;border-radius:8px;border:1px solid #ccc;background:#fff;cursor:pointer}
.f{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin:6px 0}.f input,.f select{padding:7px;border:1px solid #ddd;border-radius:8px;width:100%;font:inherit}
.tot{display:flex;justify-content:space-between;font-size:13px;margin:2px 0}.big{font-size:22px;font-weight:800;color:#E65100}
.q{display:flex;gap:4px;margin:4px 0;flex-wrap:wrap}.q button{flex:1;padding:6px;border-radius:8px;border:1px solid #FF6F00;background:#fff;cursor:pointer;font-weight:700;font-size:12px}
#pay{background:#FF6F00;color:#fff;border:0;border-radius:12px;padding:13px;font-size:16px;font-weight:800;cursor:pointer;margin-top:6px}#pay:disabled{background:#ccc}
#rc{display:none;position:fixed;inset:0;background:#0008;align-items:center;justify-content:center}#rc div{background:#fff;padding:18px;border-radius:14px;width:320px;max-height:90vh;overflow:auto;font-family:monospace;font-size:13px}
@media(max-width:800px){main{flex-direction:column}.R{width:100%;max-height:55vh}}
@media print{body *{visibility:hidden}#rc div,#rc div *{visibility:visible}#rc div{position:absolute;left:0;top:0}.np{display:none}}
</style></head><body>
<header>🥟 <span>KASIR DIMPIK</span><b id="st">●</b><button class="tab" onclick="setUrl()">⚙</button></header>
<main><div class="L"><div id="tabs"></div><input id="q" placeholder="Cari menu..." oninput="draw()"><div id="grid"></div></div>
<div class="R"><div id="cart"></div>
<div class="f" style="grid-template-columns:1fr"><select id="tipe"><option>Takeaway</option><option>Delivery</option></select></div>
<div class="tot"><b>TOTAL</b><span class="big" id="tt">Rp 0</span></div>
<button id="pay" onclick="pay()" disabled>BAYAR & SIMPAN</button><button class="tab" style="margin-top:4px" onclick="cart={};draw()">Kosongkan</button></div></main>
<div id="rc" onclick="if(event.target==this)this.style.display='none'"><div id="rcb"></div></div>
<script>
const M=[["pr-1", "Promo Dimsum Goreng Keju Lumer (Isi 3)", "promo", 16000], ["pr-2", "Promo Goreng Keju Lumer + Mentai (Isi 4) + Gratis Chili Oil", "promo", 34000], ["i4-1", "Dimsum Original (Isi 4)", "isi4", 14000], ["i4-2", "Dimsum Goreng (Isi 4)", "isi4", 16000], ["i4-3", "Dimsum Mentai (Isi 4)", "isi4", 18000], ["i4-4", "Dimsum Ha Hu (Isi 4)", "isi4", 18000], ["i4-5", "Dimsum Nori Goreng (Isi 4)", "isi4", 16000], ["i4-6", "Dimsum Mentai Keju (Isi 4)", "isi4", 21000], ["i6-1", "Dimsum Original (Isi 6)", "isi6", 21000], ["i6-2", "Dimsum Goreng (Isi 6)", "isi6", 24000], ["i6-3", "Dimsum Mentai (Isi 6)", "isi6", 27000], ["i6-4", "Dimsum Ha Hu (Isi 6)", "isi6", 27000], ["i6-5", "Dimsum Nori Goreng (Isi 6)", "isi6", 24000], ["i6-6", "Dimsum Mentai Keju (Isi 6)", "isi6", 31000], ["i8-1", "Dimsum Original (Isi 8)", "isi8", 28000], ["i8-2", "Dimsum Goreng (Isi 8)", "isi8", 32000], ["i8-3", "Dimsum Mentai (Isi 8)", "isi8", 36000], ["i8-4", "Dimsum Ha Hu (Isi 8)", "isi8", 36000], ["i8-5", "Dimsum Nori Goreng (Isi 8)", "isi8", 32000], ["i8-6", "Dimsum Mentai Keju (Isi 8)", "isi8", 41000], ["i16-1", "Dimsum Original (Isi 16)", "isi16", 56000], ["i16-2", "Dimsum Goreng (Isi 16)", "isi16", 64000], ["i16-3", "Dimsum Mentai (Isi 16)", "isi16", 72000], ["i16-4", "Dimsum Ha Hu (Isi 16)", "isi16", 72000], ["i16-5", "Dimsum Nori Goreng (Isi 16)", "isi16", 64000], ["i16-6", "Dimsum Mentai Keju (Isi 16)", "isi16", 82000], ["sp-1", "Udang Goreng Keju (Isi 3)", "special", 12000], ["sp-2", "Dimsum Goreng Keju Original (Isi 3)", "special", 17000], ["sp-3", "Dimsum Goreng Keju Original (Isi 6)", "special", 33000], ["sp-4", "Dimsum Goreng Keju Mentai (Isi 3)", "special", 23000], ["sp-5", "Dimsum Goreng Keju Mentai (Isi 6)", "special", 45000], ["fz-1", "Dimsum Frozen (Isi 50)", "frozen", 125000], ["ad-1", "Chili Oil Tambahan", "addon", 2000], ["ad-2", "Keju Slice", "addon", 3000], ["ad-3", "Topper Ulang Tahun", "addon", 5000], ["ad-4", "Lilin Ulang Tahun", "addon", 5000]];const CAT=['Promo','Isi 4','Isi 6','Isi 8','Isi 16','Goreng Keju','Frozen','Add On'],KEY={promo:'Promo',isi4:'Isi 4',isi6:'Isi 6',isi8:'Isi 8',isi16:'Isi 16',special:'Goreng Keju',frozen:'Frozen',addon:'Add On'};
let SHEET_URL='https://script.google.com/macros/s/AKfycbx7ekeUZfzudONK9i4CUoLfMl5znGeVp7oKKp4wuT736kyeN--95K13VQ_QXrs8b-BC9w/exec';
try{SHEET_URL=localStorage.url||SHEET_URL}catch(e){}
let cart={},cat='Promo',Q=JSON.parse(localStorage.antre||'[]');
const rp=n=>'Rp '+Math.round(n).toLocaleString('id-ID'),$=id=>document.getElementById(id);
$('tabs').innerHTML=CAT.map(c=>`<button class="tab" onclick="cat='${c}';draw()">${c}</button>`).join('');
function setUrl(){const u=prompt('Tempel URL Web App Apps Script (/exec):',SHEET_URL);if(u){SHEET_URL=u.trim();localStorage.url=SHEET_URL;flush()}}
function draw(){const s=$('q').value.toLowerCase();
 document.querySelectorAll('.tab').forEach(b=>b.classList.toggle('on',b.textContent==cat));
 $('grid').innerHTML=M.filter(m=>s?m[1].toLowerCase().includes(s):KEY[m[2]]==cat).map(m=>`<button class="it" onclick="add('${m[0]}',1)"><b>${m[1]}</b><i>${rp(m[3])}</i></button>`).join('');
 $('cart').innerHTML=Object.keys(cart).map(k=>{const m=M.find(x=>x[0]==k);return `<div class="row"><span>${m[1]}<br><small>${rp(m[3])}</small></span><button onclick="add('${k}',-1)">−</button><b>${cart[k]}</b><button onclick="add('${k}',1)">+</button><b style="width:80px;text-align:right">${rp(m[3]*cart[k])}</b></div>`}).join('')||'<p style="color:#999">Pilih menu di kiri…</p>';calc()}
function add(k,d){cart[k]=(cart[k]||0)+d;if(cart[k]<=0)delete cart[k];draw()}
function sums(){let s=0;for(const k in cart)s+=M.find(x=>x[0]==k)[3]*cart[k];return s}
function calc(){$('tt').textContent=rp(sums());$('pay').disabled=!Object.keys(cart).length}
function pay(){const t=sums();
 const id='DM'+new Date().toLocaleString('sv').replace(/\D/g,'').slice(2,12)+Math.floor(Math.random()*90+10);
 const o={id,tipe:$('tipe').value,total:t,
  items:Object.keys(cart).map(k=>{const m=M.find(x=>x[0]==k);return{name:m[1],cat:KEY[m[2]],price:m[3],qty:cart[k]}})};
 Q.push(o);localStorage.antre=JSON.stringify(Q);receipt(o);cart={};draw();flush()}
function receipt(o){$('rcb').innerHTML=`<center><b>DIMPIK DIMSUM</b><br>Jl. Aria Santika - Margasari<br>${new Date().toLocaleString('id-ID')}<br>${o.id} | ${o.tipe}</center><hr>`+o.items.map(i=>`${i.qty}x ${i.name}<br>&nbsp;&nbsp;${rp(i.price*i.qty)}<br>`).join('')+`<hr><b>TOTAL ${rp(o.total)}</b><center><p>Terima kasih 🙏</p></center><div class="np"><button onclick="print()">🖨 Cetak</button> <button onclick="$('rc').style.display='none'">Tutup</button></div>`;$('rc').style.display='flex'}
let busy=0;async function flush(){if(busy)return;busy=1;if(!SHEET_URL){busy=0;$('st').textContent='⚙ Isi URL Sheet dulu';return}
 while(Q.length){try{const r=await fetch(SHEET_URL,{method:'POST',headers:{'Content-Type':'text/plain;charset=utf-8'},body:JSON.stringify(Q[0])});const j=await r.json();if(!j.ok)throw 0;Q.shift();localStorage.antre=JSON.stringify(Q)}catch(e){break}}
 busy=0;$('st').textContent=Q.length?'⏳ '+Q.length+' belum terkirim':'✅ Tersimpan ke Sheet'}
setInterval(flush,15000);draw();flush();
</script></body></html>
